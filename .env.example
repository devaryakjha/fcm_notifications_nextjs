# Public web app values: Firebase console > Project settings > General > Your apps.
# Copy to .env.local. Never place a service-account key or access token here.
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-project-number
NEXT_PUBLIC_FIREBASE_APP_ID=your-web-app-id
# Project settings > Cloud Messaging > Web Push certificates > public key.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-public-vapid-key
